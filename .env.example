# Database Configuration
# Copy this file to .env and update with your actual values

# ============================================
# DATABASE URL
# ============================================
# Choose ONE of the following based on your database provider:

# For PostgreSQL (Supabase, Railway, Render, CockroachDB):
# Using pg8000 driver (Windows-compatible):
# DATABASE_URL=postgresql+pg8000://username:password@host:port/database
# Example: DATABASE_URL=postgresql+pg8000://postgres:mypassword@db.xxx.supabase.co:5432/postgres

# For MySQL (PlanetScale, Railway, Local):
# DATABASE_URL=mysql+pymysql://username:password@host:port/database
# Example: DATABASE_URL=mysql+pymysql://user:pass@gateway.planetscale.com:3306/dbname

# For Local MySQL (default):
DATABASE_URL=mysql+pymysql://fprms_user:fprms_pass@localhost/fprms

# ============================================
# FLASK SECRET KEY
# ============================================
# Generate a secure random key for production
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-this-in-production

# ============================================
# OPTIONAL SETTINGS
# ============================================
# Flask environment (development/production)
FLASK_ENV=development

# Flask debug mode (True/False)
FLASK_DEBUG=True
